<?xml version="1.0"?>
<robot name="amr">

  <link name="base_link" />
  <joint name="base_to_chassis_joint" type="fixed">
    <parent link="base_link" />
    <child link="chassis_link" />
    <origin xyz="0 0 0" rpy="0 0 -1.5708" />
  </joint>
  <link name="chassis_link">
    <visual>
      <origin xyz="0 0 0.179749" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://amr_description/meshes/base_link.obj" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.22 0.199749" rpy="0 0 0" />
      <geometry>
        <box size="0.47 0.71 0.35" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.22 0.199749" rpy="0 0 0" />
      <mass value="25.0" /> 
      <inertia ixx="1.3054" ixy="0" ixz="0" iyy="0.7154" iyz="0" izz="1.5104" />
    </inertial>
  </link>
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://amr_description/meshes/imu_link.obj" scale="1 1 1" />
      </geometry>
    </visual>
    <inertial>
      <mass value="0.05" /> 
      <inertia ixx="1.21e-05" ixy="0" ixz="0" iyy="6.11e-06" iyz="0" izz="1.62e-05" />
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="chassis_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.179749" rpy="0 0 0" /> 
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0.085781 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://amr_description/meshes/lidar_link.obj" scale="1 1 1" />
      </geometry>
    </visual>
    <inertial>
      <mass value="0.2" />
      <inertia ixx="0.000436" ixy="0" ixz="0" iyy="0.000451" iyz="0" izz="0.000586" />
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="chassis_link" />
    <child link="lidar_link" />
    <origin xyz="0 -0.085781 0.179749" rpy="0 0 0" /> 
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>540</samples>
            <resolution>1</resolution>
            <min_angle>-1.5708</min_angle>
            <max_angle>1.5708</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <link name="enclosure_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://amr_description/meshes/enclosure_link.obj" scale="1 1 1" />
      </geometry>
    </visual>
    <inertial>
      <mass value="2.0" /> 
      <inertia ixx="0.09913" ixy="0" ixz="0" iyy="0.04993" iyz="0" izz="0.12283" />
    </inertial>
  </link>

  <joint name="enclosure_joint" type="fixed">
    <parent link="chassis_link" />
    <child link="enclosure_link" />
    <origin xyz="0 0 0.179749" rpy="0 0 0" /> 
  </joint>

  <link name="caster1_link">
    <visual>
      <origin xyz="0.16 0.03 0.114749" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://amr_description/meshes/caster1_link.obj" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.065" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2" /> <!-- PLACEHOLDER mass -->
      <inertia ixx="0.000338" ixy="0" ixz="0" iyy="0.000338" iyz="0" izz="0.000338" />
    </inertial>
  </link>

  <joint name="caster1_joint" type="fixed">
    <parent link="chassis_link" />
    <child link="caster1_link" />
    <origin xyz="-0.16 -0.03 0.065" rpy="0 0 0" /> 
  </joint>

  <gazebo reference="caster1_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <link name="caster2_link">
    <visual>
      <origin xyz="-0.16 0.03 0.114749" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://amr_description/meshes/caster2_link.obj" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.065" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2" /> 
      <inertia ixx="0.000338" ixy="0" ixz="0" iyy="0.000338" iyz="0" izz="0.000338" />
    </inertial>
  </link>

  <joint name="caster2_joint" type="fixed">
    <parent link="chassis_link" />
    <child link="caster2_link" />
    <origin xyz="0.16 -0.03 0.065" rpy="0 0 0" /> 
  </joint>

  <gazebo reference="caster2_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <link name="caster3_link">
    <visual>
      <origin xyz="0.16 -0.49 0.114749" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://amr_description/meshes/caster3_link.obj" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.065" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2" /> 
      <inertia ixx="0.000338" ixy="0" ixz="0" iyy="0.000338" iyz="0" izz="0.000338" />
    </inertial>
  </link>

  <joint name="caster3_joint" type="fixed">
    <parent link="chassis_link" />
    <child link="caster3_link" />
    <origin xyz="-0.16 0.49 0.065" rpy="0 0 0" /> 
  </joint>

  <gazebo reference="caster3_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <link name="caster4_link">
    <visual>
      <origin xyz="-0.16 -0.49 0.114749" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://amr_description/meshes/caster4_link.obj" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.065" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2" /> 
      <inertia ixx="0.000338" ixy="0" ixz="0" iyy="0.000338" iyz="0" izz="0.000338" />
    </inertial>
  </link>

  <joint name="caster4_joint" type="fixed">
    <parent link="chassis_link" />
    <child link="caster4_link" />
    <origin xyz="0.16 0.49 0.065" rpy="0 0 0" /> 
  </joint>

  <gazebo reference="caster4_link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="-0.1902635 -0.233008 0.094749" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://amr_description/meshes/wheel_left_link.obj" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.085" length="0.06" />
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0" /> 
      <inertia ixx="0.018063" ixy="0" ixz="0" iyy="0.010531" iyz="0" izz="0.010531" />
    </inertial>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="chassis_link" />
    <child link="wheel_left_link" />
    <origin xyz="0.1902635 0.233008 0.085" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <dynamics damping="0.1" friction="0.0" /> 
  </joint>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0.1902635 -0.233088 0.094749" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://amr_description/meshes/wheel_right_link.obj" scale="1 1 1" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.085" length="0.06" />
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0" /> 
      <inertia ixx="0.018063" ixy="0" ixz="0" iyy="0.010531" iyz="0" izz="0.010531" />
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="chassis_link" />
    <child link="wheel_right_link" />
    <origin xyz="-0.1902635 0.233088 0.085" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <dynamics damping="0.1" friction="0.0" /> <!-- back to the ORIGINAL default, same reasoning as wheel_left_joint above -->
  </joint>
  <gazebo>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_left_joint</joint_name>
      <use_force_commands>true</use_force_commands>
      <p_gain>2.0</p_gain>   
      <i_gain>0.1</i_gain>  
      <d_gain>0.0</d_gain>  
      <cmd_max>5.0</cmd_max>
      <cmd_min>-5.0</cmd_min>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>wheel_right_joint</joint_name>
      <use_force_commands>true</use_force_commands>
      <p_gain>2.0</p_gain>  
      <i_gain>0.1</i_gain>  
      <d_gain>0.0</d_gain>   
      <cmd_max>5.0</cmd_max>
      <cmd_min>-5.0</cmd_min>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </gazebo>

  <link name="camera_left_link">
    <visual>
      <origin xyz="-0.119515 0.033443 0.054824" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://amr_description/meshes/camera_left_link.obj" scale="1 1 1" />
      </geometry>
    </visual>
    <inertial>
      <mass value="0.1" />
      <inertia ixx="4.698e-05" ixy="0" ixz="0" iyy="1.496e-04" iyz="0" izz="1.532e-04" />
    </inertial>
  </link>

  <joint name="camera_left_joint" type="fixed">
    <parent link="chassis_link" />
    <child link="camera_left_link" />
    <origin xyz="0.119515 -0.033443 0.124925" rpy="0 0 0" /> <!-- measured camera mount + chassis-wide ground-contact Z offset -->
  </joint>
  <gazebo reference="camera_left_link">
    <sensor name="camera_left_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <visualize>true</visualize>
      <topic>camera_left/image</topic>
      <gz_frame_id>camera_left_link</gz_frame_id>
      <pose>-0.0 -0.05 0.12400 0 -0.0 -1.720</pose>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov> <!-- 60 deg, PLACEHOLDER -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50</far>
        </clip>
        <camera_info_topic>camera_left/camera_info</camera_info_topic>
      </camera>
    </sensor>
  </gazebo>

  <link name="camera_right_link">
    <visual>
      <origin xyz="0.118646 0.033526 0.054825" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://amr_description/meshes/camera_right_link.obj" scale="1 1 1" />
      </geometry>
    </visual>
    <inertial>
      <mass value="0.1" /> 
      <inertia ixx="4.698e-05" ixy="0" ixz="0" iyy="1.496e-04" iyz="0" izz="1.532e-04" />
    </inertial>
  </link>

  <joint name="camera_right_joint" type="fixed">
    <parent link="chassis_link" />
    <child link="camera_right_link" />
    <origin xyz="-0.118646 -0.033526 0.124924" rpy="0 0 0" />
  </joint>

  <gazebo reference="camera_right_link">
    <sensor name="camera_right_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <visualize>true</visualize>
      <topic>camera_right/image</topic>
      <gz_frame_id>camera_right_link</gz_frame_id>
      <pose>-0.0 -0.05 0.12400 0 -0.0 -1.720</pose> 
      <camera>
        <horizontal_fov>1.0472</horizontal_fov> 
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50</far>
        </clip>
        <camera_info_topic>camera_right/camera_info</camera_info_topic>
      </camera>
    </sensor>
  </gazebo>

</robot>
